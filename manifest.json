{
  "manifest_version": 3,
  "name": "Reborn Vote",
  "version": "1.1.1",
  "description": "Получает награду за голосование в Reborn Shop запросами, без открытия формы.",
  "permissions": ["storage", "alarms", "notifications", "tabs", "scripting"],
  "host_permissions": ["https://l2reborn.org/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reborn Vote",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reborn-vote@l2reborn.local",
      "strict_min_version": "128.0"
    }
  }
}
